<Project Sdk="Microsoft.NET.Sdk">
  <!-- Syntax check for the merged script (C# 6, like the programmable block).
       It cannot check the Space Engineers API itself: that needs the game's DLLs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
</Project>
